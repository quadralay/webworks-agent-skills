<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="urn:WebWorks-Publish-Project" Version="1.1.2.0"
         ProjectID="hMDzxVACF5I" RuntimeVersion="2026.1" FormatVersion="{Current}">
  <!--
    Minimal Designer (.wep) project used as a test fixture for a job that uses a
    Designer project as a stationery (sample-designer-stationery.waj,
    useAsStationery="True"). A Designer project carries no <format>.base snapshots,
    so transforms resolve from the Designer installation. In this mode AutoMap
    stages from this project's format configuration and strips the project's own
    ProjectID and documents below, then injects the job's <Files>.
  -->
  <Formats>
    <Format TargetName="WebWorks Reverb 2.0" Name="WebWorks Reverb 2.0" Type="Application" TargetID="Lf3DjZlhl_A">
      <OutputDirectory>Output\WebWorks Reverb 2.0</OutputDirectory>
    </Format>
  </Formats>
  <Groups>
    <Group Name="DesignDocs" Type="normal" Included="true" GroupID="QeGxWoyPnS0" />
  </Groups>
</Project>
